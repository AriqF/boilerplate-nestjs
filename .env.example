# Application
NODE_ENV=development
PORT=3000

# Redis — point at your EXISTING instance. Do not commit real values.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API auth (used from Task 3 onward)
# Comma-separated list of accepted API keys, e.g. key-one,key-two
API_KEYS=
# Max allowed clock skew (seconds) between client x-timestamp and server time
API_TIMESTAMP_TOLERANCE_SEC=300
