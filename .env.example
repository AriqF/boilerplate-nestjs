# Application
NODE_ENV=development
PORT=3000

# Redis — point at your EXISTING instance. Do not commit real values.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL — point at your EXISTING instance. Do not commit real values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Set to true when the database requires TLS (most managed providers)
POSTGRES_SSL=true

# API auth (used from Task 3 onward)
# Comma-separated list of accepted API keys, e.g. key-one,key-two
API_KEYS=
# Max allowed clock skew (seconds) between client x-timestamp and server time
API_TIMESTAMP_TOLERANCE_SEC=300
